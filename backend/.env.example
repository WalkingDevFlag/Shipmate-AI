# ShipMate AI — Backend Environment Variables Template

# ============================================================================
# GitHub OAuth Configuration (REQUIRED for GitHub integration)
# ============================================================================
# 1. Go to https://github.com/settings/developers/oauth-apps
# 2. Click "New OAuth App"
# 3. Fill in:
#    - Application name: ShipMate AI
#    - Homepage URL: http://localhost:8000 (dev) or your domain
#    - Authorization callback URL: http://localhost:5173/github/callback (dev)
# 4. Copy Client ID and Client Secret below:

GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:5173/github/callback

# ============================================================================
# GitHub App Configuration (Optional - for advanced features)
# ============================================================================
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ============================================================================
# LLM provider for prose-field enhancement (PlanForge / GuardRail / TestPilot)
# ============================================================================
# SHIPMATE_LLM_PROVIDER selects the LLM backend for BOTH the agents (coder,
# decomposer) and the prose-enhancement layer:
#   `azure` (default) = Azure OpenAI function-calling — the hosted production
#                       path (Azure AI Foundry deployment).
#   `bedrock`         = AWS Bedrock Converse API — optional alternative backend
#                       (uses the standard boto3 credential provider chain).
# The legacy LLM_PROVIDER key below is still honoured (SHIPMATE_LLM_PROVIDER
# wins if both are set). Numeric scores/verdicts are deterministic regardless.
# SHIPMATE_LLM_PROVIDER=azure
LLM_PROVIDER=azure

# ─ Azure OpenAI (active when LLM_PROVIDER=azure) ────────────────────────────
# Create an Azure OpenAI resource, deploy two chat models, and copy the values:
#   az cognitiveservices account create --kind OpenAI --sku S0 ...
#   az cognitiveservices account deployment create --deployment-name <smart> ...
#   az cognitiveservices account keys list ... --query key1 -o tsv
# DEPLOYMENT_SMART/FAST are the DEPLOYMENT names you chose (not model names),
# mirroring BEDROCK_MODEL_SMART / BEDROCK_MODEL_FAST.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_SMART=shipmate-smart
AZURE_OPENAI_DEPLOYMENT_FAST=shipmate-fast

# ─ AWS Bedrock (optional — active only when LLM_PROVIDER=bedrock) ───────────
# Uses the standard boto3 credential provider chain (env vars, shared config
# file, or instance role) — boto3 picks up ~/.aws/credentials automatically.
# Model IDs use cross-region inference profiles (`us.*`); the newer Claude
# generation routes through inference profiles rather than on-demand throughput.
AWS_REGION=us-west-2
BEDROCK_MODEL_SMART=us.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_FAST=us.anthropic.claude-haiku-4-5-20251001-v1:0

# ============================================================================
# Azure Storage & Database
# ============================================================================
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;
AZURE_STORAGE_CONTAINER_NAME=shipmate-reports
AZURE_COSMOS_CONNECTION_STRING=AccountEndpoint=https://...;AccountKey=...;

# ============================================================================
# Azure Application Insights (Telemetry)
# ============================================================================
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;

# ============================================================================
# Azure Key Vault (optional)
# ============================================================================
AZURE_KEYVAULT_URL=https://your-vault.vault.azure.net/

# ============================================================================
# General Configuration
# ============================================================================
ENVIRONMENT=development
DEBUG=False
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
LOG_LEVEL=INFO

# Trust the X-Forwarded-For header for per-IP rate-limiting. Leave FALSE unless
# the app runs behind a TRUSTED reverse proxy that sets it (e.g. Azure Container
# Apps ingress). When false (default), the unforgeable socket peer IP is used —
# a client cannot spoof XFF to dodge the limiter. Set true ONLY behind a proxy.
TRUST_PROXY_HEADERS=false

# ============================================================================
# Database Connection (for future use)
# ============================================================================
DATABASE_URL=postgresql://user:password@localhost/shipmate_db
FRONTEND_URL=http://localhost:5173

# ============================================================================
# Local State Stores (sqlite) — unified under one base dir
# ============================================================================
# All three sqlite stores (inflight registry, report history, OAuth state) +
# the session vault live under SHIPMATE_STORE_DIR. Default /tmp (wiped on
# reboot). For a hosted deploy point this at a DURABLE, ideally ENCRYPTED
# volume — it now holds the session vault, the ONE place a GitHub token rests.
# SHIPMATE_STORE_DIR=/var/lib/shipmate
# Per-store legacy overrides still win when set:
#   SHIPMATE_INFLIGHT_DB / SHIPMATE_REPORTS_DB / OAUTH_STATE_DB / SHIPMATE_SESSIONS_DB
# Memory / observability stores added with the architecture work (all under
# SHIPMATE_STORE_DIR unless individually overridden):
#   SHIPMATE_TRACE_DB            run-trace observability rows (one per LLM call)
#   SHIPMATE_FINDING_MEMORY_DB   semantic finding memory (rephrase dedup)
#   SHIPMATE_CODER_LESSONS_DB    per-repo Coder failure lessons
#   SHIPMATE_CAPABILITY_DB       security-control posture snapshots + drift
#   SHIPMATE_REPO_INDEX_DB       persistent (commit-SHA-keyed) RepoIndex L2
# Session TTL (seconds) for the token vault. Default 7 days.
# SHIPMATE_SESSION_TTL_S=604800

# ============================================================================
# RepoIndex cache — analyze a repo once, reuse across pipelines
# ============================================================================
# TTL (seconds) for the in-memory (L1) repo-context/RepoLens cache. 0 disables it.
# REPO_INDEX_TTL_S=300
# Persistent (L2) RepoIndex: keyed by branch-head COMMIT SHA, so it survives a
# restart and is shared across workers (a hit means the exact tree was already
# built — never stale, since a push is a new SHA). Sanity max-age in seconds.
# REPO_INDEX_PERSIST_MAX_AGE_S=86400

# ============================================================================
# Semantic finding dedup (anti-recurrence)
# ============================================================================
# Cosine-similarity threshold above which a candidate finding is treated as a
# rephrase of a shipped/dismissed one and suppressed. Calibrated for the lexical
# embedder (rephrases ~0.69-0.76, different findings ~0.01-0.04). Raise it if you
# install a real embedding model via finding_memory.set_embedder().
# SHIPMATE_FINDING_SIM_THRESHOLD=0.55

# ============================================================================
# Validation gates
# ============================================================================
# Local pytest gate (dogfood) — runs ShipMate's own tests before opening a PR
# against its own repo. On by default.
# SHIPMATE_PYTEST_GATE=1
# Target-repo gate — for OTHER repos: clone the target, apply the patch, run
# ITS test command in a sandboxed subprocess before opening a PR.
# ⚠️  OFF by default: it RUNS UNTRUSTED USER CODE. Only enable on an isolated
# host/VM/container. The subprocess gets a stripped env (no secrets), bounded
# timeouts, and the clone is always cleaned up — but that's a floor, not a jail.
# SHIPMATE_TARGET_REPO_GATE=0
# SHIPMATE_TARGET_CLONE_TIMEOUT_S=60
# SHIPMATE_TARGET_TEST_TIMEOUT_S=180

# ── Sandbox (Phase 2) ───────────────────────────────────────────────────────
# git-worktree gate: the local pytest gate runs in a THROWAWAY `git worktree`
# checked out at HEAD, so the real working tree is never mutated (crash-safe +
# concurrency-safe). On by default when git is available; falls back to the
# legacy snapshot/restore path automatically when no worktree can be created.
# Set to 0 to force the snapshot path.
# SHIPMATE_WORKTREE_GATE=1
#
# Docker jail for the TARGET-REPO gate (untrusted user code). When docker is
# present, the cloned repo's test suite runs in a container with --network none,
# read-only root, a tmpfs HOME (so ~/.aws etc. don't exist), and resource caps —
# the real containment. When docker is absent, the gate falls back to a host
# subprocess with a stripped env + EPHEMERAL HOME (no secret env vars, and ~ is
# redirected to an empty dir so a hostile test can't read the operator's creds).
# SHIPMATE_DOCKER_IMAGE=python:3.12-slim
# SHIPMATE_DOCKER_MEMORY=1g
# SHIPMATE_DOCKER_CPUS=2
# SHIPMATE_DOCKER_PIDS=512

# ── Inner verify-loop (Phase 4) ─────────────────────────────────────────────
# After the Coder emits, a bounded loop runs the CHEAP checks (AST lint + scope
# guard + sandbox import-smoke), feeds concrete errors back, and re-prompts —
# before the expensive full pytest gate / PR. Bounded by iterations (default 2)
# AND, optionally, an approx-token budget for the active run. Set a positive
# value to enable the token bound (0/unset ⇒ iteration cap only). The smoke
# (execution) step shares the pytest gate's kill-switch — SHIPMATE_PYTEST_GATE=0
# disables BOTH; the pure lint+scope checks always run.
# SHIPMATE_VERIFY_TOKEN_BUDGET=0

# ============================================================================
# EvalOps (Phase 5)
# ============================================================================
# A ValidationSpec (scenarios + metric/log expectations) is executed against the
# booted app by eval_runner — the generalization of test_synthesizer's coverage
# signal to declarative "did the scenarios pass / metrics fire / logs stay
# clean". The CI eval-gate runs backend/app/evals/baseline.json and uploads
# eval-report.json (CIWatcher consumes it like JUnit XML).
#   SHIPMATE_METRICS_FILE   metrics sink path (the eval harness sets an isolated
#                           one per run; defaults under SHIPMATE_STORE_DIR).
#   SHIPMATE_EVAL_TIMEOUT_S timeout for a sandboxed (worktree) eval run. Default 120.
# SHIPMATE_EVAL_TIMEOUT_S=120

# ── EvalOps acceptance gate (P5 wiring) ──────────────────────────────────────
# When 1, a feature/milestone actuation on the SELF repo must also pass a
# generated ValidationSpec (boots the patched app in a worktree, runs scenarios)
# before a PR opens — "shipped" then means "the change works", not just "it
# linted + passed pytest". OFF by default (adds latency + an LLM call/actuate).
# Fully fail-open: eval-infra errors are treated as no-signal, never block.
# SHIPMATE_EVAL_GATE=0
